{
    "version": 8,
    "name": "Basic Preview",
    "sources": {
        "openmaptiles": {
            "type": "vector",
            "url": "http://localhost:8080/germany"
        }
    },
    "sprite": "http://localhost:8080/sprite/sprites?v=2",
    "glyphs": "http://localhost:8080/font/{fontstack}/{range}",
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#f8f4f0"
            }
        },
        {
            "id": "landcover-grass",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landcover",
            "filter": [
                "==",
                "class",
                "grass"
            ],
            "paint": {
                "fill-color": "#d8e8c8"
            }
        },
        {
            "id": "landcover-wood",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landcover",
            "filter": [
                "==",
                "class",
                "wood"
            ],
            "paint": {
                "fill-color": "#c0d8a0"
            }
        },
        {
            "id": "landuse-residential",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landuse",
            "filter": [
                "==",
                "class",
                "residential"
            ],
            "paint": {
                "fill-color": "#e8e0d8"
            }
        },
        {
            "id": "landuse-commercial",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landuse",
            "filter": [
                "==",
                "class",
                "commercial"
            ],
            "paint": {
                "fill-color": "#f0e8e0"
            }
        },
        {
            "id": "landuse-industrial",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landuse",
            "filter": [
                "==",
                "class",
                "industrial"
            ],
            "paint": {
                "fill-color": "#e0d8d0"
            }
        },
        {
            "id": "park",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "park",
            "paint": {
                "fill-color": "#d0e8c0"
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "paint": {
                "fill-color": "#a0c8f0"
            }
        },
        {
            "id": "waterway",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "waterway",
            "paint": {
                "line-color": "#a0c8f0",
                "line-width": [
                    "interpolate",
                    [
                        "linear"
                    ],
                    [
                        "zoom"
                    ],
                    8,
                    [
                        "match",
                        [
                            "get",
                            "class"
                        ],
                        "river",
                        1,
                        0.5
                    ],
                    14,
                    [
                        "match",
                        [
                            "get",
                            "class"
                        ],
                        "river",
                        4,
                        "canal",
                        3,
                        1.5
                    ],
                    20,
                    [
                        "match",
                        [
                            "get",
                            "class"
                        ],
                        "river",
                        10,
                        "canal",
                        6,
                        3
                    ]
                ]
            }
        },
        {
            "id": "building",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "building",
            "paint": {
                "fill-color": "#d8d0c8",
                "fill-outline-color": "#c0b8b0"
            }
        },
        {
            "id": "building-3d",
            "type": "fill-extrusion",
            "source": "openmaptiles",
            "source-layer": "building",
            "minzoom": 14,
            "paint": {
                "fill-extrusion-color": "rgba(200, 200, 200, 1)",
                "fill-extrusion-height": {
                    "property": "render_height",
                    "type": "identity"
                },
                "fill-extrusion-base": {
                    "property": "render_min_height",
                    "type": "identity"
                },
                "fill-extrusion-opacity": 1,
                "fill-extrusion-translate-anchor": "map"
            }
        },
        {
            "id": "path",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "path"
            ],
            "paint": {
                "line-color": "#cba",
                "line-width": {
                    "stops": [
                        [
                            14,
                            0.5
                        ],
                        [
                            16,
                            1
                        ],
                        [
                            20,
                            2
                        ]
                    ]
                },
                "line-dasharray": [
                    2,
                    1
                ]
            }
        },
        {
            "id": "road-service",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "service"
            ],
            "paint": {
                "line-color": "#ffffff",
                "line-width": {
                    "stops": [
                        [
                            8,
                            0.5
                        ],
                        [
                            12,
                            1
                        ],
                        [
                            16,
                            2
                        ]
                    ]
                }
            }
        },
        {
            "id": "road-minor",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "in",
                "class",
                "minor",
                "tertiary"
            ],
            "paint": {
                "line-color": "#ffffff",
                "line-width": {
                    "stops": [
                        [
                            8,
                            0.5
                        ],
                        [
                            12,
                            1.5
                        ],
                        [
                            16,
                            3
                        ]
                    ]
                }
            }
        },
        {
            "id": "road-secondary",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "secondary"
            ],
            "paint": {
                "line-color": "#f8f8f8",
                "line-width": {
                    "stops": [
                        [
                            8,
                            0.5
                        ],
                        [
                            12,
                            2
                        ],
                        [
                            16,
                            4
                        ]
                    ]
                }
            }
        },
        {
            "id": "road-primary",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "primary"
            ],
            "paint": {
                "line-color": "#fcd6a4",
                "line-width": {
                    "stops": [
                        [
                            8,
                            1
                        ],
                        [
                            12,
                            2.5
                        ],
                        [
                            16,
                            5
                        ]
                    ]
                }
            }
        },
        {
            "id": "road-trunk",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "trunk"
            ],
            "paint": {
                "line-color": "#fdb893",
                "line-width": {
                    "stops": [
                        [
                            6,
                            0.5
                        ],
                        [
                            8,
                            1
                        ],
                        [
                            12,
                            3
                        ],
                        [
                            16,
                            6
                        ]
                    ]
                }
            }
        },
        {
            "id": "road-motorway",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "motorway"
            ],
            "paint": {
                "line-color": "#ffa0a0",
                "line-width": {
                    "stops": [
                        [
                            6,
                            0.5
                        ],
                        [
                            8,
                            1.5
                        ],
                        [
                            12,
                            3.5
                        ],
                        [
                            16,
                            7
                        ]
                    ]
                }
            }
        },
        {
            "id": "rail",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "filter": [
                "==",
                "class",
                "rail"
            ],
            "paint": {
                "line-color": "#bbb",
                "line-width": 2,
                "line-dasharray": [
                    3,
                    3
                ]
            }
        },
        {
            "id": "road-label",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "transportation_name",
            "layout": {
                "text-field": "{name}",
                "text-font": [
                    "Open Sans Regular"
                ],
                "text-size": 10,
                "symbol-placement": "line"
            },
            "paint": {
                "text-color": "#333",
                "text-halo-color": "#fff",
                "text-halo-width": 1
            }
        },
        {
            "id": "poi-level-3",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "poi",
            "minzoom": 17,
            "filter": [
                "all",
                [
                    "==",
                    "$type",
                    "Point"
                ],
                [
                    ">=",
                    "rank",
                    25
                ],
                [
                    "any",
                    [
                        "!has",
                        "level"
                    ],
                    [
                        "==",
                        "level",
                        0
                    ]
                ],
                [
                    "!in",
                    "class",
                    "railway",
                    "bus"
                ]
            ],
            "layout": {
                "visibility": "none",
                "icon-image": [
                    "coalesce",
                    ["get", "subclass"],
                    ["get", "class"]
                ],
                "icon-size": 1,
                "icon-allow-overlap": false,
                "text-field": "{name}",
                "text-font": [
                    "Open Sans Regular"
                ],
                "text-size": 10,
                "text-offset": [
                    0,
                    1.5
                ],
                "text-anchor": "top",
                "text-max-width": 8,
                "text-optional": true,
                "icon-padding": 2
            },
            "paint": {
                "text-color": "#333333",
                "text-halo-color": "#ffffff",
                "text-halo-width": 1.5
            }
        },
        {
            "id": "poi-level-2",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "poi",
            "minzoom": 16,
            "filter": [
                "all",
                [
                    "==",
                    "$type",
                    "Point"
                ],
                [
                    ">=",
                    "rank",
                    10
                ],
                [
                    "<",
                    "rank",
                    25
                ],
                [
                    "any",
                    [
                        "!has",
                        "level"
                    ],
                    [
                        "==",
                        "level",
                        0
                    ]
                ],
                [
                    "!in",
                    "class",
                    "railway",
                    "bus"
                ]
            ],
            "layout": {
                "visibility": "none",
                "icon-image": [
                    "coalesce",
                    ["get", "subclass"],
                    ["get", "class"]
                ],
                "icon-size": 1,
                "icon-allow-overlap": false,
                "text-field": "{name}",
                "text-font": [
                    "Open Sans Regular"
                ],
                "text-size": 11,
                "text-offset": [
                    0,
                    1.5
                ],
                "text-anchor": "top",
                "text-max-width": 8,
                "text-optional": true,
                "icon-padding": 2
            },
            "paint": {
                "text-color": "#333333",
                "text-halo-color": "#ffffff",
                "text-halo-width": 1.5
            }
        },
        {
            "id": "poi-level-1",
            "type": "symbol",
            "source": "openmaptiles",
            "source-layer": "poi",
            "minzoom": 14,
            "filter": [
                "all",
                [
                    "==",
                    "$type",
                    "Point"
                ],
                [
                    "<",
                    "rank",
                    10
                ],
                [
                    "has",
                    "name"
                ],
                [
                    "any",
                    [
                        "!has",
                        "level"
                    ],
                    [
                        "==",
                        "level",
                        0
                    ]
                ],
                [
                    "!in",
                    "class",
                    "railway",
                    "bus"
                ]
            ],
            "layout": {
                "visibility": "none",
                "icon-image": [
                    "coalesce",
                    ["get", "subclass"],
                    ["get", "class"]
                ],
                "icon-size": 1,
                "icon-allow-overlap": false,
                "text-field": "{name}",
                "text-font": [
                    "Open Sans Regular"
                ],
                "text-size": 12,
                "text-offset": [
                    0,
                    1.5
                ],
                "text-anchor": "top",
                "text-max-width": 8,
                "text-optional": true,
                "icon-padding": 2
            },
            "paint": {
                "text-color": "#333333",
                "text-halo-color": "#ffffff",
                "text-halo-width": 1.5
            }
        },
        {
            "id": "place-village",
